# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Providers
GOOGLE_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_LOCAL_URL=http://127.0.0.1:11434

# DJN orchestration
DJN_MAX_ROUNDS=3
DJN_THRESHOLD=0.75
DJN_MIN_IMPROVEMENT=0.05
DJN_STAGNATION_ROUNDS=1
DJN_MIN_OK_JURORS=2
DJN_MAX_CONCURRENCY=4
DJN_PROVIDER_TIMEOUT_SECONDS=120
DJN_PROVIDER_MIN_INTERVAL_MS=0
DJN_MAX_RETRIES=2
DJN_CIRCUIT_BREAKER_FAILURES=5
DJN_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
DJN_SELECTION_SEED=0

# Optional Google Docs integration
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_OAUTH_REDIRECT_URI=
